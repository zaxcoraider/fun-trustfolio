# Deployer private key (never commit the real .env)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Treasury wallet address (Gnosis Safe multi-sig — MUST be set before mainnet)
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS

# Oracle address — the backend server wallet that signs claim vouchers
# Generate a dedicated wallet for this, store private key securely on the backend
ORACLE_ADDRESS=0xYOUR_ORACLE_ADDRESS

# 0G Network RPC
OG_MAINNET_RPC=https://evmrpc.0g.ai
OG_TESTNET_RPC=https://evmrpc-testnet.0g.ai

# Explorer APIs
OG_TESTNET_EXPLORER_API=https://chainscan-galileo.0g.ai/api
